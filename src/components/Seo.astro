---
/**
 * Replaces the react-helmet based SEO component. Astro renders head tags
 * natively, so this is plain markup with no runtime and no dependency — which
 * is what made moving to React 19 free.
 */
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  description?: string;
  /** Set on blog posts; switches og:type and emits the published time. */
  publishedTime?: Date;
}

// Site-wide name and fallback description are editable content, not code —
// they come from the same personal_details entry the home hero uses.
const personal = (await getCollection('personal'))[0];

const SITE = {
  title: personal.data.title,
  author: personal.data.title,
  description: personal.data.seoDescription,
  imageAlt: 'danpurdy — the dpurdy.me wordmark on a midnight ground',
  twitter: 'DanPurdy0',
};

const { title, description, publishedTime } = Astro.props;
const metaDescription = description || SITE.description;
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL('/og-card.png', Astro.site);
---

<title>{title} | {SITE.title}</title>
<meta name="description" content={metaDescription} />
<link rel="canonical" href={canonical} />

<meta property="og:site_name" content={SITE.title} />
<meta property="og:title" content={title} />
<meta property="og:description" content={metaDescription} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={SITE.imageAlt} />
<meta property="og:type" content={publishedTime ? 'article' : 'website'} />
<meta property="og:url" content={canonical} />
{
  publishedTime && (
    <meta
      property="article:published_time"
      content={publishedTime.toISOString()}
    />
  )
}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:creator" content={`@${SITE.twitter}`} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={metaDescription} />

<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE.title}
  href={new URL('rss.xml', Astro.site)}
/>
<link rel="sitemap" href="/sitemap-index.xml" />
