---
import { getCollection, render, type CollectionEntry } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';
import { readingTime } from '../../lib/reading-time';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  );

  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      // gatsby-node.js computed these into page context and blog-post.tsx never
      // rendered them. Newest first, so "next" is the newer neighbour.
      next: index === 0 ? null : posts[index - 1],
      previous: index === posts.length - 1 ? null : posts[index + 1],
    },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
  next: CollectionEntry<'blog'> | null;
  previous: CollectionEntry<'blog'> | null;
}

const { post, next, previous } = Astro.props;
const { Content } = await render(post);

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  });

// Titles like "Firebase Cloud Firestore security rules - Part one - Writing
// the rules" get an accent-coloured second half: split on the first " - "
// only, so any further dashes stay in the emphasised remainder. The title
// text itself is rendered exactly as written in frontmatter.
const DASH_SPLIT = ' - ';
const dashIndex = post.data.title.indexOf(DASH_SPLIT);
const titleBefore =
  dashIndex === -1 ? post.data.title : post.data.title.slice(0, dashIndex);
const titleAfter =
  dashIndex === -1 ? null : post.data.title.slice(dashIndex + DASH_SPLIT.length);
---

<BaseLayout title={post.data.title} description={post.data.description} width="narrow">
  <div class="post-hd">
    <div class="crumb">
      <a href="/">Writing</a> · {formatDate(post.data.date)} · {readingTime(post.body)}
    </div>
    <h1>
      {titleAfter === null ? titleBefore : <>{titleBefore} - <em>{titleAfter}</em></>}
    </h1>
    {
      post.data.tags.length > 0 && (
        <div class="meta">
          <span class="tags">
            {post.data.tags.map((tag) => <a href={`/tags/${tag}/`}>#{tag}</a>)}
          </span>
        </div>
      )
    }
  </div>

  <article class="prose">
    <Content />
  </article>

  {
    (previous || next) && (
      <div class="pn">
        {previous ? (
          <a href={`/blog/${previous.id}/`}>
            <small>← Older</small>
            <b>{previous.data.title}</b>
          </a>
        ) : (
          <span />
        )}
        {next ? (
          <a class="next" href={`/blog/${next.id}/`}>
            <small>Newer →</small>
            <b>{next.data.title}</b>
          </a>
        ) : (
          <span />
        )}
      </div>
    )
  }
</BaseLayout>

<style>
  .post-hd {
    margin: 52px 0 44px;
    padding-bottom: 36px;
    border-bottom: 1px solid var(--line);
  }

  .crumb {
    font:
      600 12px 'JetBrains Mono',
      monospace;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 18px;
  }

  .crumb a {
    color: var(--accent);
    text-decoration: none;
  }

  .post-hd h1 {
    font:
      800 clamp(34px, 4.6vw, 52px) / 1.06 'Figtree Variable',
      sans-serif;
    letter-spacing: -0.035em;
    max-width: 24ch;
    text-wrap: balance;
  }

  .post-hd h1 em {
    font-style: normal;
    color: var(--accent);
  }

  .meta {
    margin-top: 16px;
    color: var(--ink-faint);
    font-size: 15.5px;
  }

  .meta .tags {
    display: inline-flex;
    gap: 6px;
  }

  .meta .tags a {
    font:
      600 13px 'JetBrains Mono',
      monospace;
    color: var(--accent);
    text-decoration: none;
    background: var(--accent-soft);
    border-radius: 6px;
    padding: 3px 8px;
  }

  .pn {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin: 64px 0 0;
  }

  .pn a {
    background: var(--ground-raise);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 18px 20px;
    text-decoration: none;
    color: var(--ink);
  }

  .pn a:hover {
    border-color: var(--accent);
  }

  .pn small {
    display: block;
    font:
      600 12px 'JetBrains Mono',
      monospace;
    color: var(--ink-faint);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 6px;
  }

  .pn b {
    font-size: 16px;
    font-weight: 700;
    line-height: 1.35;
  }

  .pn .next {
    text-align: right;
  }

  @media (max-width: 640px) {
    .pn {
      grid-template-columns: 1fr;
    }
  }
</style>
