---
/**
 * Consolidates ExperienceItem, ExperienceItemLogo, ExperienceDateSection and
 * ExperienceSubsection. The three sub-components were single-use wrappers; their
 * class names are preserved exactly.
 */
import { Image } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';

interface Props {
  role: CollectionEntry<'experience'>;
}

const { role } = Astro.props;
const { Content } = await render(role);

// Matches Gatsby's formatString: "MMM YYYY"
const monthYear = (date: Date) =>
  date.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });

const { title, url, logo, startDate, endDate, isCurrent, position, previousPosition } =
  role.data;

const subSection = 'mb-6 text-exp leading-exp font-normal md:text-lg md:leading-relaxed';
const subTitle = 'm-0 mb-1 text-lg text-pastel-blue font-normal xl:text-base';
---

<div class="mb-48">
  <div class="mb-14">
    <div class="w-full">
      <a href={url} target="_blank" rel="noopener noreferrer">
        <Image src={logo} alt={`${title} logo`} class="w-full max-w-[300px]" />
      </a>
    </div>
  </div>

  <div class="flex flex-col xl:flex-row">
    <div
      class="mb-8 pb-4 border-b border-faded-line xl:flex-[1_1_30%] xl:border-b-0 xl:pb-0 xl:mb-0 xl:pr-8"
    >
      <div class={subSection}>
        <h4 class={subTitle}>Employed</h4>
        {monthYear(startDate)} - {
          isCurrent ? 'Now' : endDate ? monthYear(endDate) : ''
        }
      </div>

      <div class={subSection}>
        <h4 class={subTitle}>Position</h4>
        <ul class="list-none p-0 m-0">
          {position.map((pos) => <li class="py-0.5">{pos}</li>)}
        </ul>
      </div>

      {
        previousPosition.length > 0 && (
          <div class={subSection}>
            <h4 class={subTitle}>Previous Positions</h4>
            <ul class="list-none p-0 m-0">
              {previousPosition.map((pos) => (
                <li class="py-0.5">{pos}</li>
              ))}
            </ul>
          </div>
        )
      }
    </div>

    <div
      class="leading-exp text-white xl:flex-[3_3_70%] md:text-xl/10 md:leading-relaxed [&>p]:mb-10 [&>p:last-child]:mb-0"
    >
      <Content />
    </div>
  </div>
</div>
