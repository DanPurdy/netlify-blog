---
/**
 * Standalone page for Headroom, the macOS menu bar app. A product page, not a
 * blog post, so like the mixframe page it is self-contained: no BaseLayout,
 * no shared styles.
 *
 * A neutral ground, a regular-weight serif headline, a grotesque for
 * everything else, pill buttons, and a lot of air. The only colour is the
 * app's own: its amber glyph, and the two tool tints it gives each account,
 * Claude's terracotta and Codex's blue.
 *
 * The dropdown images are real renders of the app, captured from a demo build
 * pointed at a fabricated data directory (HEADROOM_HOME plus a fake home), so
 * they are genuine app output without being anyone's usage. The small ones
 * are unscaled crops of the Usage render; the guide is the app's own window.
 */
import { Image } from 'astro:assets';

import usage from '../../assets/headroom/usage.png';
import history from '../../assets/headroom/history.png';
import pace from '../../assets/headroom/pace.png';
import cache from '../../assets/headroom/cache.png';
import live from '../../assets/headroom/live.png';
import guide from '../../assets/headroom/guide.png';

const version = '0.7.1';
const repo = 'https://github.com/DanPurdy/headroom';
const installCommand =
  'curl -fsSL https://raw.githubusercontent.com/DanPurdy/headroom/main/scripts/install.sh | bash';

const title = 'Headroom';
const description =
  'A macOS menu bar app that shows how much of your coding agent plan limits you have used, for every account on your Mac at once. Works with Claude Code and Codex.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/headroom/icon.svg" />
    <link rel="icon" type="image/png" sizes="64x64" href="/headroom/favicon-64.png" />
    <link rel="apple-touch-icon" href="/headroom/apple-touch-icon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://dpurdy.me/apps/headroom/" />
    <meta property="og:image" content="https://dpurdy.me/headroom/og-card.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header class="wrap">
      <a class="brand" href="/apps/headroom/">
        <img src="/headroom/icon.svg" alt="" width="30" height="30" />
        Headroom
      </a>
      <nav>
        <a href="#install">Install</a>
        <a href={`${repo}/releases`}>What's new</a>
        <a href={repo}>GitHub</a>
      </nav>
    </header>

    <main>
      <section class="hero wrap">
        <h1>See how much of your plan you have left.</h1>
        <p>
          A menu bar gauge of your 5-hour and weekly limits, and the pace you're burning them at,
          for every Claude Code and Codex account on your Mac. Out of the box it reads what each
          tool already writes down: no login, no API calls. Switch on Live and it checks your
          account directly too.
        </p>
        <div class="buttons">
          <a class="pill solid" href={`${repo}/releases/latest`}>Download for macOS</a>
          <a class="pill" href="#install">Install from the terminal</a>
        </div>
      </section>

      <figure class="desktop wrap" aria-label="Headroom's gauge in the macOS menu bar, with its dropdown open">
        <div class="scene">
          <div class="menubar" aria-hidden="true">
            <span class="apple"></span>
            <span class="app">Finder</span>
            <span class="menu">File</span>
            <span class="menu">Edit</span>
            <span class="menu">View</span>
            <span class="menu">Go</span>
            <span class="menu">Window</span>
            <span class="menu">Help</span>
            <span class="gap"></span>
            <span class="gauge">
              <span class="col">
                <span class="lbl">Claude</span>
                <span class="rows">
                  <span class="r"><i style="--v: 38%"></i><b>38%</b></span>
                  <span class="r"><i style="--v: 61%"></i><b>61%</b></span>
                </span>
              </span>
              <span class="col">
                <span class="lbl">Codex</span>
                <span class="rows">
                  <span class="r"><i style="--v: 17%"></i><b>17%</b></span>
                  <span class="r"><i style="--v: 42%"></i><b>42%</b></span>
                </span>
              </span>
            </span>
            <span class="clock">Tue 09:41</span>
          </div>
          <Image
            class="dropdown"
            src={usage}
            alt="The dropdown: a Claude card in terracotta and a Codex card in blue, each with 5-hour and weekly bars, a pace line on each and reset countdowns; the Claude card adds a model's own weekly limit, extra usage, today's cost and the open sessions with their prompt cache countdowns"
            width={340}
            loading="eager"
          />
        </div>
      </figure>

      <section class="split wrap">
        <h2>Every account at once</h2>
        <p class="lede">
          One column per account in the menu bar. Open it for reset countdowns, the sessions you
          have running, and how fast you're going. Each tool keeps its own colour.
        </p>
        <div class="tools">
          <div class="tool claude">
            <!-- Drawn in CSS to the card's look; numbers match the renders. -->
            <div class="bars" aria-hidden="true">
              <span>5-hour <em>38%</em></span><i style="--v: 38%; --p: 46%"></i>
              <span>Weekly <em>61%</em></span><i style="--v: 61%; --p: 54%"></i>
            </div>
            <h3>Claude Code</h3>
            <p>
              Connect a folder and Headroom hears every reply through its status line, which keeps
              working as before. You also get today's cost and each conversation's prompt cache.
            </p>
          </div>
          <div class="tool codex">
            <div class="bars" aria-hidden="true">
              <span>5-hour <em>17%</em></span><i style="--v: 17%; --p: 30%"></i>
              <span>Weekly <em>42%</em></span><i style="--v: 42%; --p: 47%"></i>
            </div>
            <h3>Codex</h3>
            <p>
              Track a folder and Headroom reads the logs Codex already keeps, from the CLI, IDE
              extension and app. No login, nothing changed, plus any model's own limit while
              you're using it.
            </p>
          </div>
        </div>
      </section>

      <section class="trio wrap">
        <div>
          <h3>Know your pace</h3>
          <p>
            A line on each bar marks how much of the window has passed. Ahead of it, Headroom says
            when you'd run out at this rate.
          </p>
          <Image
            class="detail"
            src={pace}
            alt="The Claude account's bars: 5-hour at 38% with the pace line ahead of it, Weekly at 61% with the line behind it and the note 'On course to run out in 2d 10h'"
            width={312}
          />
        </div>
        <div>
          <h3>Mind the cache</h3>
          <p>
            Each Claude Code conversation shows how long until its prompt cache goes cold and the
            next message costs full price. A warning marks one that missed.
          </p>
          <Image
            class="detail"
            src={cache}
            alt="Three open sessions: one with 47 minutes of cache left and a warning, one being watched with 4 minutes left, and one whose cache has gone cold"
            width={312}
          />
        </div>
        <div>
          <h3>Warned in time</h3>
          <p>
            Alerts at 80% or 90% of any limit, and when it resets. Click a flame for a nudge five
            minutes before that cache goes cold.
          </p>
          <!-- Drawn in CSS, worded exactly as the app words its notifications. -->
          <div class="notes" aria-label="Two Headroom notifications">
            <div class="note">
              <img src="/headroom/icon.svg" alt="" width="34" height="34" />
              <div>
                <b>Codex: 5-hour 90%</b>
                <span>5-hour resets in 1h 12m</span>
              </div>
              <time>now</time>
            </div>
            <div class="note">
              <img src="/headroom/icon.svg" alt="" width="34" height="34" />
              <div>
                <b>Release notes for 2.4: cache goes cold in 5 minutes</b>
                <span>After that, the next message re-reads the conversation at full price.</span>
              </div>
              <time>2m ago</time>
            </div>
          </div>
        </div>
      </section>

      <section class="feature">
        <div class="wrap">
          <Image
            src={history}
            alt="The History page over 7 days: a chart per account of 5-hour and weekly usage, totals, then each conversation's share of the limits"
            width={340}
          />
          <div>
            <h2>What used it</h2>
            <p>
              History charts each account's 5-hour and weekly usage over the last hour, 12 hours,
              day or week, then lists the conversations that took the most from your limits.
            </p>
            <p>
              With Live on, readings from claude.ai and your other devices land here too, so use
              from elsewhere isn't pinned on your next Claude Code conversation.
            </p>
          </div>
        </div>
      </section>

      <section class="quiet wrap">
        <h2>Private by default</h2>
        <div class="cols">
          <div>
            <h3>Reads, never writes</h3>
            <p>
              Headroom reads what Claude Code and Codex already write down. Unless you switch on
              Live, it never touches your login or calls Anthropic or OpenAI.
            </p>
          </div>
          <div>
            <h3>Live, if you want it</h3>
            <p>
              Switch it on for a Claude account to count use from claude.ai and other devices, and
              to see a model's own weekly limit and your extra usage. It reads your login only when
              you ask, and keeps it in memory.
            </p>
            <Image
              class="detail live"
              src={live}
              alt="A Fable weekly bar at 44%, and the line 'Extra usage $12.40 of $50.00 this month'"
              width={312}
            />
          </div>
          <div>
            <h3>Keeps itself current</h3>
            <p>
              Once a day it asks GitHub for a new release and offers to install it. Switch that off
              and leave Live off, and Headroom makes no network requests at all.
            </p>
          </div>
        </div>
      </section>

      <section class="guide wrap">
        <h2>Set up in a minute</h2>
        <p class="lede">
          The first time it opens, a guide finds your Claude Code and Codex folders, connects the
          ones you pick, and explains every bar, line and icon on a card.
        </p>
        <Image
          src={guide}
          alt="The setup guide's 'Reading a card' step: a key to every symbol on the left, two sample account cards on the right"
          width={760}
        />
      </section>

      <section class="install wrap" id="install">
        <h2>Install</h2>
        <p>
          Needs macOS 14, and Claude Code signed in with a Pro, Max or Team plan, Codex signed
          in with ChatGPT, or both. The prompt cache countdown needs Claude Code 2.1.251 or
          later.
        </p>
        <div class="command">
          <pre><code>{installCommand}</code></pre>
          <button type="button" class="copy" data-copy={installCommand}>Copy</button>
        </div>
        <p class="small">
          Or <a href={`${repo}/releases/latest`}>download Headroom {version}</a> and move it
          to Applications. It isn't notarised yet, so allow it under Privacy &amp; Security the
          first time.
        </p>
        <ol>
          <li>Open Headroom. A setup guide lists the accounts it found.</li>
          <li>Label each one, then Connect a Claude Code folder or Track a Codex one.</li>
          <li>Send a message in either. Its usage appears.</li>
        </ol>
        <p class="small">
          Skipped the guide? Click the gauge, then the gear. It's under Setup guide… there.
        </p>
      </section>
    </main>

    <footer class="wrap">
      <p>
        Open source, MIT. Made by <a href="/">Dan Purdy</a>, not affiliated with Anthropic or OpenAI.{' '}
        <a href="/projects/headroom/">Project notes</a>.
      </p>
    </footer>

    <script>
      for (const button of document.querySelectorAll<HTMLButtonElement>('.copy')) {
        button.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(button.dataset.copy ?? '');
            button.textContent = 'Copied';
          } catch {
            button.textContent = 'Select and copy';
          }
          setTimeout(() => (button.textContent = 'Copy'), 1800);
        });
      }
    </script>
  </body>
</html>

<style>
  :root {
    color-scheme: light;
    --bg: #f4f4f2;
    --bg-raise: #fbfbfa;
    --ink: #141414;
    --ink-soft: #5c5c5a;
    --line: #dfdfdb;
    /* The app's tool tints (Brand in UsageView.swift). */
    --claude: #d97757;
    --codex: #5869f7;
    --serif: 'Iowan Old Style', 'Tiempos Text', 'Palatino Linotype', Palatino, Georgia, serif;
    --sans: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Arial, sans-serif;
    --mono: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font: 400 17px/1.5 var(--sans);
    -webkit-font-smoothing: antialiased;
  }

  .wrap {
    max-width: 1040px;
    margin: 0 auto;
    padding: 0 32px;
  }

  a {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  :focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }

  h1,
  h2 {
    font-family: var(--serif);
    font-weight: 400;
    letter-spacing: -0.01em;
    margin: 0;
  }

  header.wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 28px;
    padding-bottom: 96px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 500;
    font-size: 18px;
    text-decoration: none;
  }

  .brand img {
    display: block;
    border-radius: 7px;
  }

  nav {
    display: flex;
    gap: 28px;
    font-size: 15px;
  }

  nav a {
    text-decoration: none;
  }

  nav a:hover {
    text-decoration: underline;
  }

  .hero {
    max-width: 760px;
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  h1 {
    font-size: clamp(38px, 6vw, 64px);
    line-height: 1.08;
  }

  .hero p {
    font-size: 19px;
    line-height: 1.5;
    color: var(--ink-soft);
    max-width: 560px;
    margin: 24px auto 0;
  }

  .buttons {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .pill {
    display: inline-block;
    padding: 12px 22px;
    border-radius: 999px;
    border: 1px solid var(--ink);
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
  }

  .pill:hover {
    background: var(--bg-raise);
  }

  .pill.solid {
    background: var(--ink);
    color: var(--bg);
  }

  .pill.solid:hover {
    background: #000;
  }

  /* A corner of a desktop: the menu bar, and the dropdown hanging from the gauge. */
  .desktop {
    margin: 72px auto 120px;
  }

  .scene {
    position: relative;
    background: #e8e8e5;
    border: 1px solid var(--line);
    border-radius: 16px;
    overflow: hidden;
    padding: 30px 0 32px;
  }

  .menubar {
    position: absolute;
    inset: 0 0 auto 0;
    display: flex;
    align-items: center;
    gap: 17px;
    height: 30px;
    padding: 0 12px 0 18px;
    background: rgba(255, 255, 255, 0.5);
    border-bottom: 1px solid rgba(20, 20, 19, 0.08);
    font-size: 13px;
    white-space: nowrap;
    overflow: hidden;
  }

  .menubar .app {
    font-weight: 700;
  }

  .menubar .gap {
    flex: 1;
  }

  .apple {
    width: 13px;
    height: 15px;
    background: var(--ink);
    mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 170 170'><path d='M150 130c-3 7-6 13-11 19-6 8-12 14-21 14-8 0-11-5-21-5s-13 5-21 5c-9 0-16-7-22-15-13-19-23-53-10-77 7-12 18-19 31-19 9 0 17 6 22 6 6 0 15-7 26-6 4 0 17 2 25 13-1 1-15 9-15 26 0 21 18 28 18 28zM110 25c4-6 8-14 7-22-7 1-15 5-20 10-4 5-8 13-7 21 7 0 15-4 20-9z'/></svg>")
      center / contain no-repeat;
  }

  /* Drawn to the app's dimensions: 11pt label, two 28×4 bars, 8pt percentages. */
  .gauge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 22px;
    padding: 0 6px;
    border-radius: 4px;
    background: rgba(20, 20, 19, 0.1);
  }

  .gauge .col {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .gauge .lbl {
    font-size: 11px;
    font-weight: 500;
  }

  .gauge .rows {
    display: inline-flex;
    flex-direction: column;
    gap: 1px;
  }

  .gauge .r {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    height: 8px;
  }

  .gauge .r i {
    width: 28px;
    height: 4px;
    border-radius: 1.5px;
    background: linear-gradient(90deg, var(--ink) var(--v), rgba(20, 20, 19, 0.3) var(--v));
  }

  .gauge .r b {
    font-size: 8px;
    font-weight: 500;
    width: 20px;
    font-variant-numeric: tabular-nums;
  }

  .clock {
    font-size: 13px;
    font-weight: 500;
  }

  .dropdown {
    display: block;
    width: 340px;
    max-width: calc(100% - 24px);
    height: auto;
    margin: 4px 100px 0 auto;
    border-radius: 11px;
    box-shadow:
      0 0 0 0.5px rgba(0, 0, 0, 0.35),
      0 18px 36px -12px rgba(20, 20, 19, 0.45);
  }

  /* Section rhythm: a split pair, a trio of details, a full-bleed feature, a quiet strip. */
  main h2 {
    font-size: 40px;
    line-height: 1.12;
  }

  main h3 {
    font: 500 19px/1.3 var(--sans);
    margin: 0 0 8px;
  }

  main section p {
    color: var(--ink-soft);
  }

  /* Screenshots and crops of the app. */
  main section img:not(.note img) {
    display: block;
    height: auto;
    max-width: 100%;
    border-radius: 11px;
    box-shadow:
      0 0 0 0.5px rgba(0, 0, 0, 0.35),
      0 14px 28px -12px rgba(20, 20, 20, 0.4);
  }

  /* Unscaled crops from inside a card, shown at their natural size so they stay sharp. */
  img.detail {
    border-radius: 8px;
  }

  .split {
    text-align: center;
  }

  .lede {
    max-width: 560px;
    margin: 16px auto 0;
    font-size: 19px;
  }

  .tools {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: 48px;
    text-align: left;
  }

  .tool {
    padding: 28px;
    border-radius: 16px;
    background: var(--bg-raise);
    border: 1px solid var(--line);
    border-top: 3px solid var(--tint);
  }

  .tool.claude {
    --tint: var(--claude);
  }

  .tool.codex {
    --tint: var(--codex);
  }

  .tool p {
    margin: 0;
    font-size: 16px;
  }

  /* A card's two bars, with the pace line as a tick. */
  .bars {
    display: grid;
    gap: 6px;
    margin-bottom: 28px;
    font-size: 13px;
  }

  .bars span {
    display: flex;
    justify-content: space-between;
    color: var(--ink-soft);
  }

  .bars em {
    font-style: normal;
    font-variant-numeric: tabular-nums;
  }

  .bars i {
    position: relative;
    height: 6px;
    margin-bottom: 8px;
    border-radius: 3px;
    background: linear-gradient(90deg, var(--tint) var(--v), rgba(20, 20, 20, 0.1) var(--v));
  }

  .bars i::after {
    content: '';
    position: absolute;
    left: var(--p);
    top: -2px;
    width: 2px;
    height: 10px;
    border-radius: 1px;
    background: var(--ink);
    opacity: 0.55;
  }

  .trio {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    margin-top: 120px;
  }

  .trio p {
    margin: 0 0 24px;
    font-size: 16px;
  }

  /* macOS notification banners, at their real size. */
  .notes {
    display: grid;
    gap: 8px;
    font-size: 13px;
    line-height: 1.3;
  }

  .note {
    display: grid;
    grid-template-columns: 34px 1fr auto;
    gap: 10px;
    align-items: start;
    padding: 11px 12px;
    border-radius: 16px;
    background: var(--bg-raise);
    box-shadow:
      0 0 0 0.5px rgba(0, 0, 0, 0.18),
      0 10px 24px -14px rgba(20, 20, 20, 0.45);
  }

  .note img {
    display: block;
    border-radius: 8px;
  }

  .note b {
    display: block;
    font-weight: 600;
  }

  .note span {
    display: block;
    color: var(--ink-soft);
  }

  .note time {
    font-size: 12px;
    color: var(--ink-soft);
  }

  .feature {
    margin-top: 120px;
    padding: 96px 0;
    background: var(--bg-raise);
    border-block: 1px solid var(--line);
  }

  .feature .wrap {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 80px;
    align-items: center;
    max-width: 920px;
  }

  .feature p {
    margin: 16px 0 0;
    font-size: 18px;
    max-width: 420px;
  }

  .quiet {
    margin-top: 120px;
  }

  .quiet .cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    margin-top: 32px;
  }

  .quiet .cols > div {
    border-top: 1px solid var(--line);
    padding-top: 20px;
  }

  .quiet p {
    margin: 0;
    font-size: 16px;
  }

  .quiet .live {
    margin-top: 20px;
  }

  .guide {
    margin-top: 120px;
    text-align: center;
  }

  .guide img {
    margin: 48px auto 0;
  }

  .install {
    max-width: 720px;
    margin: 128px auto 0;
    padding-bottom: 96px;
  }

  .install h2 {
    font-size: 34px;
    line-height: 1.15;
    margin-bottom: 12px;
  }

  .install p {
    margin: 0 0 20px;
    color: var(--ink-soft);
  }

  .install .small {
    font-size: 15px;
  }

  .command {
    display: flex;
    align-items: stretch;
    gap: 8px;
    background: var(--bg-raise);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 6px 6px 6px 16px;
    margin: 0 0 16px;
  }

  .command pre {
    flex: 1;
    min-width: 0;
    margin: 0;
