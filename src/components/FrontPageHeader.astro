---
interface Props {
  title: string;
  subtitle: string;
}

const { title, subtitle } = Astro.props;
---

<header class="my-6 mb-40 text-center lg:mb-20 xl:mb-32">
  <h1
    class="mt-8 mb-4 text-6xl tracking-tighter-5 sm:text-7xl md:text-8xl md:tracking-tighter-7 lg:text-9xl lg:tracking-tighter-8"
  >
    {title}
  </h1>
  <h2
    class="my-4 text-neon-pink text-4xl md:text-4-5xl lg:text-5xl tracking-tighter-2"
  >
    {subtitle}
  </h2>
</header>
