---
/**
 * Standalone landing page for Headroom, the macOS menu bar app. Like the
 * mixframe page it is a product page, not a blog post, so it is deliberately
 * self-contained: no BaseLayout, no shared styles. The look borrows Claude's
 * warm cream-and-terracotta palette and serif display type, with Headroom's
 * own twist on top: the head-in-profile glyph and its amber-to-flame level.
 *
 * The hero "scene" (menu bar + dropdown) is drawn in CSS with illustrative
 * numbers, so it stays crisp at any size and never shows a real account.
 * The gallery further down shows real renders of the Usage and History
 * pages, captured from the app running against a fabricated data directory
 * (see the headroom repo's README for the HEADROOM_HOME override), so the
 * figures are genuine app output without being anyone's real usage.
 */
import { Image } from 'astro:assets';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/600.css';

import usage from '../../assets/headroom/usage.png';
import history from '../../assets/headroom/history.png';

const version = '0.3.0';
const repo = 'https://github.com/DanPurdy/headroom';
const installCommand =
  'curl -fsSL https://raw.githubusercontent.com/DanPurdy/headroom/main/scripts/install.sh | bash';

const title = 'Headroom';
const description =
  'A macOS menu bar app that shows how much of your Claude plan limits you have used, for every Claude Code account on your Mac at once.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Claude plan limits in your menu bar</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/headroom/icon.svg" />
    <link rel="icon" type="image/png" sizes="64x64" href="/headroom/favicon-64.png" />
    <link rel="apple-touch-icon" href="/headroom/apple-touch-icon.png" />
    <meta property="og:title" content={`${title} · Claude plan limits in your menu bar`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://dpurdy.me/apps/headroom/" />
    <meta property="og:image" content="https://dpurdy.me/headroom/og-card.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <!-- The app icon's head, drawn once and reused; the level wave is what fills it. -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <defs>
        <linearGradient id="hr-fill" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#FFA041"></stop>
          <stop offset="1" stop-color="#E8590C"></stop>
        </linearGradient>
        <path
          id="hr-head"
          d="M 215 940 C 235 868, 325 836, 398 812 L 405 722 C 360 692, 300 622, 290 522 C 280 382, 370 250, 510 240 C 630 232, 705 300, 712 400 C 716 430, 726 446, 726 458 C 726 468, 720 474, 722 486 C 732 512, 752 536, 762 556 C 768 566, 760 574, 746 574 L 726 576 C 732 586, 734 598, 726 604 C 722 607, 722 610, 726 613 C 732 620, 728 634, 716 638 C 714 650, 722 666, 716 684 C 708 704, 680 712, 650 712 C 630 714, 618 730, 616 760 L 620 808 C 692 834, 788 866, 808 940 Z"
        ></path>
        <path
          id="hr-wave"
          d="M 100 548 C 170 524, 250 572, 330 548 S 490 524, 570 548 S 730 572, 924 548 L 924 960 L 100 960 Z"
        ></path>
        <clipPath id="hr-head-clip"><use href="#hr-head"></use></clipPath>
        <mask id="hr-above-wave">
          <rect width="1024" height="1024" fill="white"></rect>
          <use href="#hr-wave" fill="black" transform="translate(0 6)"></use>
        </mask>
        <g id="hr-glyph">
          <use href="#hr-head" fill="#1A1A1E" mask="url(#hr-above-wave)"></use>
          <g clip-path="url(#hr-head-clip)">
            <use href="#hr-wave" fill="url(#hr-fill)"></use>
          </g>
        </g>
        <g id="hr-glyph-cream">
          <use href="#hr-head" fill="#ECE7E0" mask="url(#hr-above-wave)"></use>
          <g clip-path="url(#hr-head-clip)">
            <use href="#hr-wave" fill="url(#hr-fill)"></use>
          </g>
        </g>
      </defs>
    </svg>

    <header class="top">
      <div class="wrap">
        <a class="brand" href="#top">
          <svg class="glyph" viewBox="205 235 610 710" aria-hidden="true">
            <use href="#hr-glyph"></use>
          </svg>
          <span>Headroom</span>
        </a>
        <nav>
          <a href="#how" class="nav-how">How it works</a>
          <a href="#install">Install</a>
          <a href={repo} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        </nav>
      </div>
    </header>

    <main id="top">
      <section class="hero wrap">
        <p class="eyebrow">macOS menu bar app · open source · reads, never writes</p>
        <h1>Know how much Claude you have <em>left</em>.</h1>
        <p class="lede">
          Headroom sits in the menu bar and shows your 5-hour and weekly plan limits for every
          Claude Code account on your Mac at once, with reset countdowns, open sessions and
          today's cost. No tokens, no API calls, no login: by default it only reads what Claude
          Code already hands to your status line.
        </p>
        <div class="cta-row">
          <a class="btn primary" href="#install">Install</a>
          <a class="btn" href={`${repo}/releases/latest`} target="_blank" rel="noopener noreferrer">
            Download v{version}
          </a>
          <span class="req">macOS 14+ · Pro, Max or Team plan</span>
        </div>
      </section>

      <section class="scene" aria-label="Headroom in the macOS menu bar">
        <div class="wrap">
          <div class="desktop">
            <div class="menubar" aria-hidden="true">
              <span class="apple"></span>
              <span class="app">Finder</span>
              <span>File</span><span>Edit</span><span>View</span><span>Go</span><span>Window</span
              ><span>Help</span>
              <span class="spacer"></span>
              <span class="gauge">
                <span class="col">
                  <span class="lbl">Main</span>
                  <span class="rows">
                    <span class="r"><i style="--v:38%"></i><b>38%</b></span>
                    <span class="r"><i style="--v:61%"></i><b>61%</b></span>
                  </span>
                </span>
                <span class="col">
                  <span class="lbl">Personal</span>
                  <span class="rows">
                    <span class="r"><i style="--v:4%"></i><b>4%</b></span>
                    <span class="r"><i style="--v:23%"></i><b>23%</b></span>
                  </span>
                </span>
              </span>
              <span class="sys">
                <span class="wifi"></span>
                <span class="batt"></span>
                <span class="clock">Tue 09:41</span>
              </span>
            </div>

            <div class="under">
              <div class="watermark" aria-hidden="true">
                <svg viewBox="205 235 610 710">
                  <use href="#hr-glyph"></use>
                </svg>
                <p>
                  One column per account. Five-hour on top, weekly below. It dims when a reading
                  is out of date.
                </p>
              </div>

              <div class="panel" aria-hidden="true">
                <div class="p-head">
                  <svg class="glyph" viewBox="205 235 610 710"><use href="#hr-glyph-cream"></use></svg>
                  <b>Headroom</b>
                  <span class="seg"><span class="on">Usage</span><span>History</span></span>
                  <span class="gear"></span>
                </div>

                <div class="card">
                  <div class="c-head">
                    <b>Main</b>
                    <span class="when">updated just now</span>
                    <span class="refresh"></span>
                  </div>
                  <div class="limit">
                    <span>5-hour</span><span>38% · resets in 2h 41m</span>
                    <i style="--v:38%"></i>
                  </div>
                  <div class="limit">
                    <span>Weekly</span><span>61% · resets in 3d 4h</span>
                    <i style="--v:61%"></i>
                  </div>
                  <div class="meta"><span>3 open sessions</span><span>$41.20 today</span></div>
                  <div class="sess"><i class="live"></i><span>Checkout retry logic</span><em>Fable 5.1</em><em>42% ctx</em></div>
                  <div class="sess"><i class="live"></i><span>Release notes for 2.4</span><em>Opus 5.5</em><em>17% ctx</em></div>
                  <div class="sess"><i></i><span>Flaky integration tests</span><em>Sonnet 5.5</em><em>63% ctx</em></div>
                </div>

                <div class="card">
                  <div class="c-head">
                    <b>Personal</b>
                    <span class="when">updated 4m ago</span>
                    <span class="refresh"></span>
                  </div>
                  <div class="limit">
                    <span>5-hour</span><span>4% · resets in 4h 12m</span>
                    <i style="--v:4%"></i>
                  </div>
                  <div class="limit">
                    <span>Weekly</span><span>23% · resets in 5d 2h</span>
                    <i style="--v:23%"></i>
                  </div>
                  <div class="meta"><span>1 open session</span><span>$2.61 today</span></div>
                  <div class="sess"><i class="live"></i><span>Headroom project page</span><em>Fable 5.1</em><em>9% ctx</em></div>
                </div>

                <div class="p-foot">Quit</div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="why wrap">
        <div class="why-copy">
          <h2>Why</h2>
          <p>
            The limits are the thing you only find out about mid-task. Claude Code will tell you
            where you stand, but only when you stop and ask, and only for the account you are in.
            If you keep a work login and a personal one, you have no idea which is about to run
            dry until it does.
          </p>
          <p>
            Headroom was built on least privilege. It never asks for your login and never calls
            an API on your behalf. Claude Code already passes your plan usage to its status line
            after every reply, so Headroom simply listens there and puts the numbers where you
            will see them. The one network feature, Live usage, is opt-in per account and only
            touches your Keychain when you press the button.
          </p>
        </div>
        <ul class="facts">
          <li><b>0</b><span>tokens used. The status line runs locally.</span></li>
          <li><b>0</b><span>network calls unless you switch Live on.</span></li>
          <li><b>∞</b><span>accounts. One column each in the menu bar.</span></li>
        </ul>
      </section>

      <section class="features wrap">
        <div class="feature">
          <h3>Every account at once</h3>
          <p>
            Each Claude Code folder is one account. The menu bar shows its label beside two small
            bars, 5-hour on top and weekly below, with the percentages. The dropdown adds reset
            countdowns.
          </p>
        </div>
        <div class="feature">
          <h3>Open sessions</h3>
          <p>
            Every open Claude Code session per account, with the model it is on and how much of
            its context it has used. Sessions quiet for 15 minutes are marked idle.
          </p>
        </div>
        <div class="feature">
          <h3>Today's cost</h3>
          <p>
            The API-equivalent cost of today's sessions, as Claude Code estimates it. Not what
            your subscription bills, but a good sense of how heavy the day has been.
          </p>
        </div>
        <div class="feature">
          <h3>History</h3>
          <p>
            Conversations with replies in the last 1, 12 or 24 hours, and how much of the 5-hour
            and weekly limits each one took in that time, with totals per account.
          </p>
        </div>
        <div class="feature">
          <h3>Reads, never writes</h3>
          <p>
            Install wraps your status line command and leaves it working exactly as before. The
            original setting is backed up, and Remove puts it back. Nothing else is touched.
          </p>
        </div>
        <div class="feature">
          <h3>Live usage, if you want it</h3>
          <p>
            Optional, per account. Checks once an hour and on demand, so use from claude.ai, the
            desktop app and other devices shows up too. The login stays in memory, never on disk.
          </p>
        </div>
      </section>

      <section class="gallery wrap">
        <h2>The dropdown</h2>
        <div class="shots">
          <figure>
            <Image src={usage} alt="The Usage page: one card per account with 5-hour and weekly bars, reset countdowns, today's cost and the open sessions" width={340} />
            <figcaption>Usage. One card per account, with its open sessions, the model each is on and how full its context is.</figcaption>
          </figure>
          <figure>
            <Image src={history} alt="The History page: a per-account table of 5-hour, weekly and cost totals, then each conversation's share of the limits" width={340} />
            <figcaption>History. What each conversation took from the limits in the last 1, 12 or 24 hours, and what it cost.</figcaption>
          </figure>
          <figure class="shot-note">
            <figcaption>
              <b>Settings</b> lists every Claude Code folder on the Mac. Give each a label, press
              Install, and optionally switch on Live usage or Launch at login. Remove puts your
              original status line back.
            </figcaption>
          </figure>
        </div>
      </section>

      <section class="how wrap" id="how">
        <h2>How it works</h2>
        <ol class="steps">
          <li>
            <b>Claude Code reports.</b> After every reply, Claude Code passes your plan usage to
            whatever command is set as its <code>statusLine</code>. That happens locally and
            costs nothing.
          </li>
          <li>
            <b>Headroom listens.</b> Install points the status line at a tiny
            <code>headroom</code> command that saves the figures to JSON files in Application
            Support, then runs your original status line with the same input.
          </li>
          <li>
            <b>The gauge redraws.</b> The app watches those files and open Claude Code processes
            with kqueue. It otherwise wakes only for moments it has worked out in advance: a limit
            resetting, a reading going stale, midnight. No polling.
          </li>
        </ol>
        <p class="note">
          Without Live, an account updates only when Claude Code replies on it. Readings older
          than 30 minutes are dimmed with an "as of" age so you can tell.
        </p>
      </section>

      <section class="install wrap" id="install">
        <div class="install-card">
          <h2>Install</h2>
          <p>
            One command downloads the latest release into Applications and opens it. Or grab
            <a href={`${repo}/releases/latest`} target="_blank" rel="noopener noreferrer"
              >Headroom-{version}.zip</a
            > from the releases page and move it there yourself.
          </p>
          <div class="cmd">
            <pre><code>{installCommand}</code></pre>
            <button type="button" class="copy" data-copy={installCommand}>Copy</button>
          </div>
          <p class="small">
            Releases aren't signed with an Apple Developer ID yet, so a browser download is
            blocked the first time you open it. Approve it under System Settings → Privacy
            &amp; Security → Open Anyway, or run
            <code>xattr -dr com.apple.quarantine /Applications/Headroom.app</code>.
          </p>

          <h3>Then</h3>
          <ol>
            <li>Click the gauge in the menu bar, then the gear to open Settings.</li>
            <li>
              Headroom lists <code>~/.claude</code> and every <code>~/.claude-*</code> folder.
              Give each a label and press <strong>Install</strong>.
            </li>
            <li>Send a message in Claude Code on that account. Its usage appears straight away.</li>
            <li>Optionally switch on <strong>Live usage</strong> and <strong>Launch at login</strong>.</li>
          </ol>
          <p class="small">
            Needs macOS 14 or later and Claude Code logged in with a Pro, Max or Team plan. To
            uninstall, press <strong>Remove</strong> on each account first so your original status
            line goes back, then delete the app.
          </p>
        </div>
      </section>
    </main>

    <footer>
      <div class="wrap">
        <p>
          Headroom is an independent open-source project (MIT) by
          <a href="/">Dan Purdy</a>. It is not affiliated with or endorsed by Anthropic.
        </p>
        <p>
          <a href={repo} target="_blank" rel="noopener noreferrer">GitHub</a> ·
          <a href={`${repo}/releases`} target="_blank" rel="noopener noreferrer">Releases</a> ·
          <a href="/projects/headroom/">Project page</a>
        </p>
      </div>
    </footer>

    <script>
      for (const button of document.querySelectorAll<HTMLButtonElement>('.copy')) {
        button.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(button.dataset.copy ?? '');
            button.textContent = 'Copied';
          } catch {
            button.textContent = 'Select & copy';
          }
          setTimeout(() => (button.textContent = 'Copy'), 1800);
        });
      }
    </script>
  </body>
</html>

<style>
  :root {
    color-scheme: light;
    --cream: #f0eee6;
    --cream-2: #faf9f5;
    --ink: #141413;
    --ink-2: #5e5d59;
    --ink-3: #87857f;
    --line: #dcd8cc;
    --clay: #d97757;
    --amber: #ffa041;
    --flame: #e8590c;
    --panel: #262625;
    --panel-2: #363634;
    --panel-3: #4a4a47;
    --panel-ink: #ece7e0;
    --panel-ink-2: #a9a7a1;
    --serif: 'Iowan Old Style', 'Palatino Linotype', Palatino, 'Book Antiqua', Georgia, serif;
    --sans: system-ui, -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif;
    --mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background: var(--cream);
    color: var(--ink);
    font: 400 17px/1.55 var(--sans);
    -webkit-font-smoothing: antialiased;
  }

  ::selection {
    background: #f8d8c6;
  }

  .wrap {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 24px;
  }

  h1,
  h2,
  h3 {
    font-family: var(--serif);
    font-weight: 500;
    letter-spacing: -0.015em;
    margin: 0;
  }

  h2 {
    font-size: clamp(30px, 3.6vw, 40px);
    line-height: 1.1;
    margin-bottom: 22px;
  }

  a {
    color: inherit;
  }

  code {
    font: 400 0.88em var(--mono);
    background: var(--cream-2);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 1px 6px;
  }

  /* header */
  .top .wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 22px;
    padding-bottom: 22px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font: 500 22px var(--serif);
    letter-spacing: -0.01em;
  }

  .glyph {
    width: 26px;
    height: 30px;
    display: block;
  }

  .top nav {
    display: flex;
    gap: 26px;
    font-size: 15px;
    font-weight: 500;
  }

  .top nav a {
    text-decoration: none;
    color: var(--ink-2);
  }

  .top nav a:hover {
    color: var(--clay);
  }

  /* hero */
  .hero {
    padding-top: 56px;
    padding-bottom: 36px;
  }

  .eyebrow {
    font: 600 12px var(--mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--clay);
    margin: 0 0 20px;
  }

  h1 {
    font-size: clamp(42px, 6.4vw, 76px);
    line-height: 1.02;
    max-width: 14ch;
  }

  h1 em {
    font-style: italic;
    color: var(--clay);
  }

  .lede {
    font-size: clamp(17px, 1.9vw, 20px);
    line-height: 1.5;
    color: var(--ink-2);
    max-width: 62ch;
    margin: 26px 0 0;
  }

  .cta-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }

  .btn {
    display: inline-block;
    padding: 12px 22px;
    border-radius: 999px;
    border: 1.5px solid var(--ink);
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
    transition:
      background 0.15s,
      color 0.15s;
  }

  .btn:hover {
    background: var(--cream-2);
  }

  .btn.primary {
    background: var(--ink);
    color: var(--cream);
  }

  .btn.primary:hover {
    background: var(--clay);
    border-color: var(--clay);
    color: #fff;
  }

  .req {
    font: 500 13px var(--mono);
    color: var(--ink-3);
    margin-left: 6px;
  }

  /* the scene: a fake menu bar with the dropdown hanging from it */
  .scene {
    padding: 20px 0 10px;
  }

  .desktop {
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid var(--line);
    background:
      radial-gradient(1200px 500px at 20% 100%, #f7d9c4 0%, transparent 60%),
      radial-gradient(900px 420px at 95% 0%, #ffe3c2 0%, transparent 55%),
      linear-gradient(180deg, #ebe6da, #e6dfd1);
    box-shadow: 0 30px 60px -40px rgba(20, 20, 19, 0.35);
  }

  .menubar {
    display: flex;
    align-items: center;
    gap: 18px;
    height: 30px;
    padding: 0 14px 0 18px;
    background: rgba(250, 249, 245, 0.78);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(20, 20, 19, 0.08);
    font: 500 13px var(--sans);
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
  }

  .menubar .app {
    font-weight: 700;
  }

  .menubar .spacer {
    flex: 1;
  }

  .apple {
    width: 13px;
    height: 15px;
    background: var(--ink);
    -webkit-mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 170 170'><path d='M150 130c-3 7-6 13-11 19-6 8-12 14-21 14-8 0-11-5-21-5s-13 5-21 5c-9 0-16-7-22-15-13-19-23-53-10-77 7-12 18-19 31-19 9 0 17 6 22 6 6 0 15-7 26-6 4 0 17 2 25 13-1 1-15 9-15 26 0 21 18 28 18 28zM110 25c4-6 8-14 7-22-7 1-15 5-20 10-4 5-8 13-7 21 7 0 15-4 20-9z'/></svg>")
      center / contain no-repeat;
    mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 170 170'><path d='M150 130c-3 7-6 13-11 19-6 8-12 14-21 14-8 0-11-5-21-5s-13 5-21 5c-9 0-16-7-22-15-13-19-23-53-10-77 7-12 18-19 31-19 9 0 17 6 22 6 6 0 15-7 26-6 4 0 17 2 25 13-1 1-15 9-15 26 0 21 18 28 18 28zM110 25c4-6 8-14 7-22-7 1-15 5-20 10-4 5-8 13-7 21 7 0 15-4 20-9z'/></svg>")
      center / contain no-repeat;
  }

  /* the gauge, drawn to the real app's dimensions */
  .gauge {
    display: inline-flex;
    gap: 10px;
    padding: 0 6px;
    height: 24px;
    align-items: center;
    border-radius: 5px;
    background: rgba(20, 20, 19, 0.08);
  }

  .gauge .col {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .gauge .lbl {
    font: 500 11px var(--sans);
  }

  .gauge .rows {
    display: inline-flex;
    flex-direction: column;
    gap: 1px;
  }

  .gauge .r {
    display: inline-flex;
