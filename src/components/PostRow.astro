---
// One row in a post list. Markup and styles transcribed from the `.post`
// anchor in mockups/d-hybrid/index.html.
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  showDescription?: boolean;
}

const { post, showDescription = true } = Astro.props;

const formattedDate = new Intl.DateTimeFormat('en-GB', {
  month: 'short',
  year: 'numeric',
}).format(post.data.date);

const tagList = post.data.tags.map((tag) => `#${tag}`).join(' ');

// Frontmatter titles use plain hyphens; display copy prefers em dashes, same
// as the post page's statement heading.
const displayTitle = post.data.title.replaceAll(' - ', ' — ');
---

<a class="post" href={`/blog/${post.id}/`}>
  <time datetime={post.data.date.toISOString()}>{formattedDate}</time>
  <h3>{displayTitle}</h3>
  <span class="tags">{tagList}</span>
  {showDescription && <p>{post.data.description}</p>}
</a>

<style>
  .post {
    display: grid;
    grid-template-columns: 92px 1fr auto;
    column-gap: 32px;
    align-items: baseline;
    padding: 32px 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }
  .post:last-of-type {
    border-bottom: 0;
  }
  .post time {
    font: 500 13px 'JetBrains Mono', monospace;
    color: var(--ink-faint);
    white-space: nowrap;
  }
  .post h3 {
    font: 800 clamp(21px, 2.3vw, 27px) / 1.15 'Figtree Variable', sans-serif;
    letter-spacing: -0.025em;
  }
  .post:hover h3 {
    color: var(--accent);
  }
  .post .tags {
    font: 500 13px 'JetBrains Mono', monospace;
    color: var(--accent);
    white-space: nowrap;
  }
  .post p {
    grid-column: 2;
    color: var(--ink-soft);
    font-size: 15.5px;
    max-width: 60ch;
    margin-top: 10px;
  }

  @media (max-width: 680px) {
    .post {
      display: flex;
      flex-wrap: wrap;
      column-gap: 14px;
      padding: 26px 0;
    }
    .post time {
      order: -2;
    }
    .post .tags {
      order: -1;
    }
    .post h3 {
      width: 100%;
      font-size: 22px;
      margin-top: 10px;
    }
    .post p {
      width: 100%;
      font-size: 15px;
      margin-top: 8px;
    }
  }
</style>
