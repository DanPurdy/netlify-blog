---
import { getCollection } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { readingTime } from '../../lib/reading-time';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-GB', {
    month: 'long',
    day: '2-digit',
    year: 'numeric',
  });
---

<BaseLayout title="Blog" variant="thin">
  <PageHeader currentLocation="Blog" />
  <section class="my-10 xl:mt-12 md:mt-8">
    {
      posts.length ? (
        posts.map((post) => (
          <div class="m-0 mb-8 py-8 border-b border-faded-line xl:mr-0">
            <a href={`/blog/${post.id}/`} class="no-underline">
              <h3 class="my-4 text-3xl leading-tight md:text-3-5xl md:leading-tight">
                {post.data.title}
              </h3>
            </a>
            {/* The listing previously showed no description, though the home page did. */}
            <p class="text-lg leading-relaxed my-2 mb-4">{post.data.description}</p>
            <div class="my-8 mb-4 text-sm flex flex-wrap items-center gap-x-8 gap-y-2">
              <span class="text-left text-neon-pink">{formatDate(post.data.date)}</span>
              <span>{readingTime(post.body)}</span>
              {post.data.tags.length > 0 && (
                <span class="flex flex-wrap gap-x-3">
                  {post.data.tags.map((tag) => (
                    <a
                      href={`/tags/${tag}/`}
                      class="no-underline text-pastel-blue hover:underline"
                    >
                      #{tag}
                    </a>
                  ))}
                </span>
              )}
            </div>
          </div>
        ))
      ) : (
        <h2>No posts yet</h2>
      )
    }
  </section>
</BaseLayout>
