---
interface Props {
  title: string;
  reverse?: boolean;
}

const { title, reverse = false } = Astro.props;
---

<div class={`flex items-end ${reverse ? 'flex-row-reverse' : 'flex-row'}`}>
  <h2
    class={`text-6xl leading-none text-neon-pink ${reverse ? 'ml-4 mr-0' : 'mr-4 ml-0'}`}
  >
    {title}
  </h2>
  <div class="flex-1 h-[3px] border-b-[3px] border-neon-pink mb-1"></div>
</div>
