---
/**
 * The plugins index. Rows follow the projects list's shape for consistency,
 * but each entry links to its own standalone landing page — plugins carry
 * their own design language (mixframe is styled after gds.fm), so they don't
 * live in the projects collection.
 *
 * Hardcoded while there's one entry; convert to a content collection when a
 * second plugin shows up.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';

const plugins = [
  {
    href: '/plugins/mixframe/',
    year: '2026',
    name: 'mixframe',
    role: 'chrome extension',
    status: 'live',
    description:
      'Captures what plays on gds.fm while you listen and saves the keepers to Spotify.',
  },
];
---

<BaseLayout
  title="Plugins"
  description="Browser extensions and plugins by Dan Purdy."
>
  <header class="page-h">
    <h1>Plugins<em>.</em></h1>
    <p class="sub">
      Browser extensions and plugins, each with its own page. Other projects live
      <a href="/projects">here</a>.
    </p>
  </header>

  <section>
    {
      plugins.map((plugin) => (
        <a class="row" href={plugin.href}>
          <time>{plugin.year}</time>
          <h3>{plugin.name}</h3>
          <span class="tags">
            {plugin.role}
            {plugin.status && ` · ${plugin.status}`}
          </span>
          <p>{plugin.description}</p>
        </a>
      ))
    }
  </section>
</BaseLayout>

<style>
  .page-h {
    padding: 56px 0 36px;
    border-bottom: 1px solid var(--line);
  }

  .page-h h1 {
    font:
      800 clamp(32px, 4.5vw, 48px) / 1.06 'Figtree Variable',
      sans-serif;
    letter-spacing: -0.035em;
  }

  .page-h h1 em {
    font-style: normal;
    color: var(--accent);
  }

  .page-h .sub {
    margin-top: 12px;
    color: var(--ink-soft);
  }

  .page-h .sub a {
    color: var(--accent);
    font-weight: 600;
    text-decoration: none;
  }

  .row {
    display: grid;
    grid-template-columns: 92px 1fr auto;
    column-gap: 32px;
    align-items: baseline;
    padding: 32px 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }

  .row:last-of-type {
    border-bottom: 0;
  }

  .row time {
    font:
      500 13px 'JetBrains Mono',
      monospace;
    color: var(--ink-faint);
    white-space: nowrap;
  }

  .row h3 {
    font:
      800 clamp(21px, 2.3vw, 27px) / 1.15 'Figtree Variable',
      sans-serif;
    letter-spacing: -0.025em;
  }

  .row:hover h3 {
    color: var(--accent);
  }

  .row .tags {
    font:
      500 13px 'JetBrains Mono',
      monospace;
    color: var(--accent);
    white-space: nowrap;
  }

  .row p {
    grid-column: 2;
    color: var(--ink-soft);
    font-size: 15.5px;
    max-width: 60ch;
    margin-top: 10px;
  }

  @media (max-width: 680px) {
    .row {
      display: flex;
      flex-wrap: wrap;
      column-gap: 14px;
      padding: 26px 0;
    }

    .row time {
      order: -2;
    }

    .row .tags {
      order: -1;
    }

    .row h3 {
      width: 100%;
      font-size: 22px;
      margin-top: 10px;
    }

    .row p {
      width: 100%;
      font-size: 15px;
      margin-top: 8px;
    }
  }
</style>
