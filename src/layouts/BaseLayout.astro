---
/**
 * Consolidates the former layout.tsx and ThinLayout.tsx. The two differed only
 * in container width and which footer they rendered.
 */
import Seo from '../components/Seo.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  keywords?: string[];
  width?: 'wide' | 'narrow';
  author?: string;
}

const { title, description, keywords, width = 'wide', author = 'Dan Purdy' } = Astro.props;

const wrapClass = width === 'narrow' ? 'wrap wrap-narrow' : 'wrap';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <Seo title={title} description={description} keywords={keywords} />
    <script is:inline>
      // Runs before first paint so the stored theme never flashes the default.
      const t = localStorage.getItem('theme');
      if (t) document.documentElement.dataset.theme = t;
    </script>
  </head>
  <body>
    <div class={wrapClass}>
      <SiteHeader />
      <main>
        <slot />
      </main>
      <SiteFooter />
    </div>
  </body>
</html>
