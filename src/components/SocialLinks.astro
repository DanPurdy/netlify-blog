---
/**
 * The icons were previously imported as React components via SVGR, which needed
 * a custom webpack rule in gatsby-node.js. Inlined here instead — no loader
 * config, no runtime, and they inherit colour from CSS.
 */
const ring =
  'w-[60px] h-[60px] rounded-full border-2 border-neon-pink flex justify-center items-center mr-4 p-2 no-underline';
---

