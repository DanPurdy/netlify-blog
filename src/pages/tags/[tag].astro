---
import { getCollection, type CollectionEntry } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';
import PostRow from '../../components/PostRow.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);

  // Routes come from the posts themselves, so a tag with no posts simply
  // produces no page rather than an empty one.
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();

  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: posts
        .filter((post) => post.data.tags.includes(tag))
        .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
    },
  }));
}

interface Props {
  tag: string;
  posts: CollectionEntry<'blog'>[];
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`Posts tagged ${tag}`} description={`Blog posts tagged ${tag}`} width="wide">
  <section class="listing">
    <header class="page-h">
      <h1><span class="hash">#</span>{tag}</h1>
      <p class="sub">
        {posts.length} {posts.length === 1 ? 'post' : 'posts'} ·{' '}
        <a href="/">all writing →</a>
      </p>
    </header>
    {posts.map((post) => <PostRow post={post} />)}
  </section>
</BaseLayout>

<style>
  .listing {
    margin-top: 52px;
  }
  .page-h {
    margin-bottom: 16px;
  }
  .page-h h1 {
    font: 800 clamp(28px, 4vw, 40px) / 1.15 'Figtree Variable', sans-serif;
    letter-spacing: -0.025em;
  }
  .page-h h1 .hash {
    color: var(--accent);
  }
  .page-h .sub {
    margin-top: 10px;
    color: var(--ink-soft);
    font-size: 15.5px;
  }
  .page-h .sub a {
    color: var(--accent);
    text-decoration: none;
    font-weight: 600;
  }
  .page-h .sub a:hover {
    text-decoration: underline;
  }
</style>
