---
/**
 * Home page. Markup and styles transcribed from mockups/d-hybrid/index.html —
 * header and footer come from BaseLayout, everything between is this page.
 */
import { getCollection, render } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';
import PostRow from '../components/PostRow.astro';

const personal = (await getCollection('personal'))[0];
const { Content: Intro } = await render(personal);

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const experience = (await getCollection('experience')).sort(
  (a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf(),
);

// "2025 —" for the current role, "2021 – 25" (full start year, en dash,
// two-digit end year) for everything else.
function formatDateRange(job: (typeof experience)[number]) {
  const startYear = job.data.startDate.getUTCFullYear();
  if (job.data.isCurrent) return `${startYear} —`;
  const endYear = (job.data.endDate ?? job.data.startDate).getUTCFullYear();
  return `${startYear} – ${String(endYear).slice(-2)}`;
}

const personJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: personal.data.title,
  jobTitle: personal.data.subtitle,
  url: Astro.site?.href,
  sameAs: personal.data.links
    .filter((link) => !link.url.startsWith('/'))
    .map((link) => link.url),
});
---

<BaseLayout title="Home">
  <div class="hero">
    <h1>
      {personal.data.headline}{' '}
      {personal.data.headlineAccent && <em>{personal.data.headlineAccent}</em>}
    </h1>
    <div class="sub">
      <Intro />
      {
        personal.data.links.length > 0 && (
          <div class="social">
            {personal.data.links.map((link) =>
              link.url.startsWith('/') ? (
                <a href={link.url}>{link.label}</a>
              ) : (
                <a href={link.url} target="_blank" rel="noopener noreferrer">
                  {link.label}
                </a>
              ),
            )}
          </div>
        )
      }
    </div>
  </div>

  <section>
    <div class="sec-h"><h2>Writing</h2><a href="/rss.xml">RSS →</a></div>
    {posts.map((post) => <PostRow post={post} />)}
  </section>

  <section>
    <div class="sec-h"><h2>Side projects</h2></div>
    <div class="projects">
      {
        projects.map((project) => (
          <a class="proj" href={project.data.url} target="_blank" rel="noopener noreferrer">
            <h3>
              {project.data.name} <span>{project.data.role}</span>
            </h3>
            <p>{project.data.description}</p>
          </a>
        ))
      }
    </div>
  </section>

  <section id="work">
    <div class="sec-h"><h2>Work</h2><a href="/work">Full history →</a></div>
    <div class="work">
      {
        experience.map((job) => (
          <a class="job" href="/work">
            <span>
              <b>{job.data.title}</b> · {job.data.position[0]}
            </span>
            <time>{formatDateRange(job)}</time>
          </a>
        ))
      }
    </div>
  </section>

  <script type="application/ld+json" set:html={personJsonLd} />
</BaseLayout>

<style>
  /* hero */
  .hero {
    padding: 64px 0 52px;
    border-bottom: 1px solid var(--line);
    position: relative;
  }
  .hero::before {
    content: '';
    position: absolute;
    top: -40px;
    right: -60px;
    width: 300px;
    height: 300px;
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--accent) 0%, transparent 70%);
    opacity: 0.1;
    pointer-events: none;
  }
  .hero h1 {
    font: 800 clamp(36px, 5vw, 58px) / 1.06 'Figtree Variable', sans-serif;
    letter-spacing: -0.035em;
    text-wrap: balance;
    max-width: 20ch;
  }
  .hero h1 em {
    font-style: normal;
    color: var(--accent);
  }
  .hero .sub {
    margin-top: 28px;
    display: flex;
    gap: 28px;
    align-items: baseline;
    flex-wrap: wrap;
  }
  .sub :global(p) {
    max-width: 52ch;
    color: var(--ink-soft);
    font-size: 17px;
  }
  .social {
    display: flex;
    gap: 16px;
    font-size: 15px;
    font-weight: 600;
    white-space: nowrap;
  }
  .social a {
    color: var(--ink-soft);
    text-decoration: none;
    border-bottom: 2px solid var(--line);
  }
  .social a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  @media (max-width: 680px) {
    .hero {
      padding: 44px 0 40px;
    }
  }

  /* sections */
  section {
    margin-top: 72px;
  }
  .sec-h {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 16px;
  }
  .sec-h h2 {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .sec-h a {
    font-size: 14.5px;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
  }

  /* side projects */
  .projects {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 14px;
  }
  .proj {
    background: var(--ground-raise);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 20px;
    text-decoration: none;
    display: block;
  }
  .proj:hover {
    border-color: var(--accent);
  }
  .proj h3 {
    font-size: 17px;
    font-weight: 700;
  }
  .proj h3 span {
    font: 400 13px 'JetBrains Mono', monospace;
    color: var(--ink-faint);
    margin-left: 8px;
  }
  .proj p {
    font-size: 14.5px;
    color: var(--ink-soft);
    margin-top: 6px;
  }

  /* work strip */
  .work {
    border-top: 1px solid var(--line);
    padding-top: 8px;
  }
  .job {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }
  .job b {
    font-size: 17px;
    font-weight: 700;
  }
  .job span {
    color: var(--ink-soft);
    font-size: 15.5px;
  }
  .job time {
    font: 500 13px 'JetBrains Mono', monospace;
    color: var(--ink-faint);
    white-space: nowrap;
  }
</style>
