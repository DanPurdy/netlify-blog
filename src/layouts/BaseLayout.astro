---
/**
 * Consolidates the former layout.tsx and ThinLayout.tsx. The two differed only
 * in container width and which footer they rendered.
 */
import Seo from '../components/Seo.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Set on blog posts; forwarded to Seo for article metadata. */
  publishedTime?: Date;
}

const { title, description, publishedTime } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Seo title={title} description={description} publishedTime={publishedTime} />
    <script is:inline>
      // Runs before first paint so the stored theme never flashes the default.
      const t = localStorage.getItem('theme');
      if (t) document.documentElement.dataset.theme = t;
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="wrap">
      <SiteHeader />
      <main id="main">
        <slot />
      </main>
      <SiteFooter />
    </div>
  </body>
</html>
